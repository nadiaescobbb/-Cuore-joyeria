# Archivo de ejemplo para variables de entorno.
# Copia este archivo como '.env' para configuraciones locales o de producción.

# URL base para cargar imágenes desde un CDN (ej. Cloudinary, AWS S3).
# Si se deja vacío, las imágenes se servirán localmente desde /public.
# Ejemplo Cloudinary:
# VITE_CDN_URL=https://res.cloudinary.com/tu-usuario/image/upload/v123456/cuore
VITE_CDN_URL=
